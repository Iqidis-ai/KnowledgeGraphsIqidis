# Knowledge Graph System - Environment Variables

# Required
GEMINI_API_KEY=your-api-key

# Default environment when a request doesn't specify one:
# "development" | "preview" | "staging" | "production"
APP_ENV=development

# Database URLs per environment (set the ones you need).
# A single server process can serve multiple environments: callers pick one
# per request via the `env` query param or the `X-Iqidis-Env` header (the
# iqidis Next.js app sends this automatically). Requests without an env use
# APP_ENV. Requesting an env whose URL isn't set here fails loudly (400/500)
# instead of silently using the default database.
development_POSTGRES_URL=postgresql://user:pass@dev-host:5432/db?sslmode=require
# preview_POSTGRES_URL=postgresql://user:pass@preview-host:5432/db?sslmode=require
# staging_POSTGRES_URL=postgresql://user:pass@staging-host:5432/db?sslmode=require
# production_POSTGRES_URL=postgresql://user:pass@prod-host:5432/db?sslmode=require

# AWS (S3 document downloads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Pipeline tuning
GEMINI_REQUESTS_PER_MINUTE=60
GEMINI_MAX_PARALLEL_WORKERS=6
MAX_DOWNLOAD_PARALLEL=6
